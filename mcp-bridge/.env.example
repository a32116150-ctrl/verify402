# Bridge configuration.
#
# The bridge runs without any of these. With no EVM_PRIVATE_KEY it exposes only
# the free preflight_gate. Set a key only when you want the five paid checks.
#
# EVM_PRIVATE_KEY is a dedicated hot wallet that pays for calls in USDC. Use a
# wallet with only the money you are willing to spend. NEVER commit the real
# .env and never use a main wallet.
EVM_PRIVATE_KEY=           # optional; omit for the free gate only
VERIFY402_URL=https://verify402.onrender.com
# spend controls (paid tools only)
MAX_PAYMENT_USD=0.25      # cap on ONE payment, enforced at signature time
MAX_DAILY_USD=0.50        # cap on the whole UTC day, survives restarts; omit to disable
SPEND_LEDGER_PATH=        # optional override for the ledger file (default .spend-ledger.json)

# payment allowlist (paid tools only; these are the defaults)
VERIFY402_NETWORKS=eip155:8453
VERIFY402_PAY_TO=0xAeEF086DD4e436c69d6d0F684b4c9F43392df9cb
# VERIFY402_RESOURCE_PREFIX=https://verify402.onrender.com
# For local testnet, set VERIFY402_NETWORKS=eip155:84532 and the payee the local server names.
