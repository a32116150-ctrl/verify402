# Bridge configuration.
#
# The bridge runs without any of these. With no EVM_PRIVATE_KEY it exposes only
# the free preflight_gate. Set a key only when you want the six paid checks.
#
# EVM_PRIVATE_KEY is a dedicated hot wallet that pays for calls in real USDC
# on Base mainnet by default. Use a small wallet with only the money you are
# willing to spend. NEVER commit the real .env and never use a main wallet.
EVM_PRIVATE_KEY=           # optional; omit for the free gate only
# Live mainnet service (real USDC). Free tools need no wallet.
VERIFY402_URL=https://vex402.online
# spend controls (paid tools only)
MAX_PAYMENT_USD=0.25      # cap on ONE payment, enforced at signature time
MAX_DAILY_USD=0.50        # cap on the whole UTC day, survives restarts; omit to disable
SPEND_LEDGER_PATH=        # optional override for the ledger file (default .spend-ledger.json)

# payment allowlist (paid tools only).
# Default: Base mainnet, real USDC. The public testnet demo was retired
# 2026-11-19; there is no public testnet endpoint.
VERIFY402_NETWORKS=eip155:8453
ROUTE_FILTER=              # optional; list-remaining-routes.mjs pays ONE route, e.g. /safety
VERIFY402_PAY_TO=0xAeEF086DD4e436c69d6d0F684b4c9F43392df9cb

# Anonymous usage telemetry, opt-in. When set to 1 the bridge sends one
# fire-and-forget line per tool call to the service: the tool name and whether
# it worked. Never arguments, intents, results, wallet data, or IPs. Default is
# off, and a failed ping never changes a tool's answer.
# VERIFY402_TELEMETRY=1
# VERIFY402_RESOURCE_PREFIX=https://vex402.online
# The payee is pinned; a 402 naming another payee is refused before signing.
# Mainnet prices are $0.03-$0.10 per call, and MAX_PAYMENT_USD is the ceiling.
