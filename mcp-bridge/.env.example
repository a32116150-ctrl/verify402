# Bridge configuration (all optional except EVM_PRIVATE_KEY)
EVM_PRIVATE_KEY=           # pre-funded wallet paying for the calls; NEVER commit the real .env
VERIFY402_URL=https://verify402.onrender.com
# spend controls
MAX_PAYMENT_USD=0.25      # cap on ONE payment, enforced at signature time
MAX_DAILY_USD=0.50        # cap on the whole UTC day, survives restarts; omit to disable
SPEND_LEDGER_PATH=        # optional override for the ledger file (default .spend-ledger.json)
