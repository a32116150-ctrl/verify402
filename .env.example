# Variables below are deliberately commented out: this file is a template, not a live
# environment. Uncomment and fill in the values you need. In mainnet mode the
# server refuses to start unless these are set: PREFLIGHT_SECRET, AGENT_URL,
# FACILITATOR_URL, and (when using Coinbase) CDP_API_KEY_ID + CDP_API_KEY_SECRET.
#
# Copy to .env. Never commit the real file.
#
# Every environment variable read by the server, registration script, test
# harness, or MCP bridge is listed below. Values shown are examples/defaults;
# replace secrets and addresses before running in mainnet.

# --- payment rails -----------------------------------------------------------
# Testnet (default): Base Sepolia + Solana devnet, public facilitator.
# X402_MODE=testnet

# Mainnet needs a production facilitator and REAL wallets. The server refuses
# to start in mainnet mode without FACILITATOR_URL, AGENT_URL, and
# PREFLIGHT_SECRET.
# Mainnet also requires an always-on paid host. On a free host keep X402_MODE=testnet.
# MAINNET_ALWAYS_ON_CONFIRMED=yes
# REQUIRE_ALWAYS_ON=1
# Never set this on a free host:
# ALLOW_MAINNET_ON_FREE_TIER=1
# X402_MODE=mainnet
# FACILITATOR_URL=https://api.cdp.coinbase.com/platform/v2/x402
# CDP_API_KEY_ID=...
# To get listed in the Coinbase Bazaar (the catalog agents search), the service
# must settle through the CDP facilitator: set FACILITATOR_URL to the CDP URL
# above AND both keys. Both missing = the server refuses the CDP path and runs
# on x402.org (testnet), which is not indexed. /health reports
# discovery: cdp-bazaar-eligible once the switch is live.
# CDP_API_KEY_SECRET=...

# Public identity. REQUIRED when X402_MODE=mainnet: the agent card must not
# derive its origin from the Host header. In testnet/local mode, unset AGENT_URL
# falls back to this Host allowlist (comma-separated hostnames).
# AGENT_URL=https://vex402.online
# TRUSTED_HOSTS=vex402.online,localhost,127.0.0.1

# Where payments land.
# PAY_TO_EVM=0x...
# PAY_TO_SVM=...

# Prices per paid call, in USD. The 402 challenge is authoritative.
# PRICE=$0.05              # /verify
# SAFETY_PRICE=$0.02       # /safety (lead check: quote-based sellability)
# ROUTE_PRICE=$0.03        # /route
# QUOTECHECK_PRICE=$0.05   # /quotecheck
# DEPTH_PRICE=$0.05        # /depth
# ASSURE_PRICE=$0.10       # /assure bundle; parts total $0.12 (safety $0.02 + quotecheck $0.05 + depth $0.05)

# --- preflight receipts ------------------------------------------------------
# HMAC secret for /preflight receipts. REQUIRED when X402_MODE=mainnet: without
# it the process would mint receipts that cannot be verified after a restart.
# Generate with: openssl rand -hex 32
# PREFLIGHT_SECRET=...

# --- settlement recovery (durable store) --------------------------------------
# Persistent SQLite file backing the settlement recovery store: a staged
# payment is journaled here BEFORE the facilitator settlement call, and
# promotion/abandon/expiry are mirrored, so a restart can never cause a double
# charge. REQUIRED in mainnet mode (the server refuses to start without it —
# never the .data default). Optional in testnet/dev: unset = historical
# memory-only behavior. On Render, point it at a persistent disk mount, e.g.
# /var/data/recovery/recovery.sqlite (requires a paid instance + 1 GB disk).
# RECOVERY_DB_PATH=.data/recovery.sqlite

# Test-only crash injection for the recovery audit. Names one durable write
# (stage:before, stage:after, promote:before, promote:after, abandon:*, evict:*,
# tombstone:*) and SIGKILLs the process there. Inert when unset. Never set this
# in a deploy; it exists so `npm run audit:recovery` can prove crash safety.
# VERIFY402_CRASH_AT=

# Aggregate page-view counts for the human site (GET /usage/site). No cookies,
# no IP, no query strings. Defaults to <RECOVERY_DB_PATH dir>/site-analytics.json
# when RECOVERY_DB_PATH is set; unset with no recovery path = process-local and
# lost on restart. Set this to keep analytics somewhere else on the same disk.
# Where /usage persists its call counters. Same idea as the site analytics,
# but for machine calls. Default: <RECOVERY_DB_PATH>/usage.json when the
# recovery store is configured, otherwise process-local and reported that way.
# VERIFY402_USAGE_PATH=.data/usage.json

# SITE_ANALYTICS_PATH=.data/site-analytics.json

# 402 directory (GET /directory, GET /directory.json). The directory re-inspects
# a small seed list every 15 minutes and records price/payee/network changes.
# History is process-local unless a file is configured; on a free host that file
# is ephemeral, so a restart starts a fresh history. Set this to keep it on a
# persistent disk mount. Set VERIFY402_DIRECTORY_WATCH=0 to disable the schedule.
# VERIFY402_DIRECTORY_FILE=.data/directory.json
# VERIFY402_DIRECTORY_WATCH=1

# 402 board (GET /board, GET /board.json, GET /badge). The board reads a daily
# structural scan published on the `board-data` branch (see
# .github/workflows/board.yml); the bundled data/board.json is the fallback.
# Override only to point at a different snapshot location.
# VERIFY402_BOARD_URL=https://raw.githubusercontent.com/a32116150-ctrl/verify402/board-data/data/board.json

# --- readiness and server ----------------------------------------------------
# READY_CHAIN_ID=1              # 1, 42161, 8453, or 84532 (Base Sepolia, readiness-only)
# READY_RPC_URL=https://your-readiness-endpoint
# BASE_SEPOLIA_RPC_URL=https://your-base-sepolia-endpoint  # fallback when READY_CHAIN_ID=84532
# PORT=4021
# SIGTERM/SIGINT drain deadline before forcing close (milliseconds).
# SHUTDOWN_TIMEOUT_MS=10000

# --- ERC-8004 agent identity registration (scripts/register-agent.mjs) --------
# PRIVATE_KEY is the OWNER's gas wallet. Never paste it into chat or a ticket.
# PRIVATE_KEY=...
# CHAIN=base-sepolia            # or: base
# CONFIRM=yes                   # required - the mint is permanent
# AGENT_URL (above) is also required for registration.
# AGENT_ID=...
# IDENTITY_REGISTRY=0x...
# CHAIN_ID=84532                # registry chain for the agent identity

# --- measurement data sources (all optional; public endpoints are the default) ---
# A private endpoint matters under sustained traffic - the public ones throttle.
# ETH_RPC_URL=https://your-mainnet-endpoint
# ARB_RPC_URL=https://your-arbitrum-endpoint
# BASE_RPC_URL=https://your-base-endpoint
# OP_RPC_URL=https://your-op-mainnet-endpoint  # free gate only (transaction preflight)
# EXPLORER_RPC_URL=https://your-base-logs-endpoint  # optional: /explorer reads
# ERC-20 Transfer logs here when Blockscout is unreachable; defaults to a
# public Base RPC (base-rpc.publicnode.com / base-sepolia-rpc.publicnode.com)
# BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# Solana RPC used ONLY to re-check a Solana payment whose settle outcome was
# lost (payment recovery). Defaults to the public endpoint for the configured
# rail (api.mainnet-beta.solana.com / api.devnet.solana.com). A private
# endpoint is recommended in production: the public one rate-limits.
# SOLANA_RPC_URL=https://your-solana-endpoint
# Free-gate plug-ins: comma-separated absolute paths to operator modules that
# export `routers` (known routers the gate can name and decode) and/or
# `enrichers` (add `involved` / `risk` to transaction advice). None ship here.
# VERIFY402_ROUTER_PLUGINS=/opt/plugins/routers.mjs,/opt/plugins/insights.mjs

# --- live paid-usage counter (/stats) ---------------------------------------
# The mainnet counter keeps a small settlement index next to the recovery store
# and extends it from the launch block. Set "off" to keep the index in memory.
# SETTLEMENT_INDEX_PATH=/var/lib/verify402/settlement-index.json
# SETTLEMENT_INDEX_START_BLOCK=59000000
# Wallets the operator controls, comma separated. Used only to separate
# operator calls from outside payers in /stats; never used for payments.
# OPERATOR_ADDRESSES=0x9a48474B06554c25258B4bc3Def5A637cBF5AD4b,0x74Dc591900aa574CBdfBEf8E3212F1FB3BA16ce8

# --- local development only --------------------------------------------------
# BYPASS_PAYMENT=1   # unprotects /verify; loud warning is printed

# --- test harness only -------------------------------------------------------
# TEST_OFFLINE=1
# TEST_RPC_ONLY=1
# TEST_OFFLINE_RPC_URL=http://127.0.0.1:1/offline-rpc

# --- post-deploy smoke (scripts/smoke.mjs) ------------------------------------
# SMOKE_BASE_URL=https://vex402.online
# SMOKE_PAID=1               # requires EVM_PRIVATE_KEY and a TESTNET target
# Expected release identity for scripts/post-deploy-check.mjs (default: current release/testnet)
# EXPECTED_VERSION=1.1.7
# EXPECTED_MODE=mainnet

# --- MCP bridge (optional; run from mcp-bridge/) -----------------------------
# Dedicated hot wallet for x402 payments only - never a trading key.
# EVM_PRIVATE_KEY=0x...
# VERIFY402_URL=https://vex402.online
# Live payment rail: Base mainnet, real USDC. This active value matches the
# bridge's runtime default.
VERIFY402_NETWORKS=eip155:8453
# Optional: list-remaining-routes.mjs pays exactly ONE paid route, e.g. /safety
ROUTE_FILTER=
# The public testnet demo was retired on 2026-11-19; there is no public
# testnet endpoint. Leave unset or eip155:8453.
# VERIFY402_PAY_TO=0x...
# VERIFY402_RESOURCE_PREFIX=https://vex402.online
# MAX_PAYMENT_USD=0.25
# MAX_DAILY_USD=5.00
# Anonymous tool-call pings: tool name + ok/failed only, no arguments,
# intents, results, wallets or IPs. Off unless explicitly set to 1.
# VERIFY402_TELEMETRY=1


# --- free gate limits --------------------------------------------------------
# Anonymous free-gate calls per IP per UTC day.
# FREE_GATE_DAILY_LIMIT=100
# Higher daily cap for operator-issued free API keys (comma-separated in
# FREE_API_KEYS), presented as X-Verify402-Key.
# FREE_API_KEY_DAILY_LIMIT=1000
# FREE_API_KEYS=key1,key2

# --- public testnet demo retirement -----------------------------------------
# The public Base Sepolia demo (verify402.onrender.com) was retired on
# 2026-11-19 — it served real mainnet analysis for testnet USDC. In testnet
# mode every route now redirects to the mainnet service (GET) or returns 410
# with demo_retired (non-GET). Set to 1 only for local development or the
# offline test harness when you need the full sandbox.
# TESTNET_DEMO_ENABLED=1

# --- local preview only ------------------------------------------------------
# Local sandbox: serve the real mainnet /stats from https://vex402.online so
# the homepage proof cards show live chain numbers instead of offline dashes.
# Never set this on a public instance; it is ignored when X402_MODE=mainnet.
# Default: unset.
# VERIFY402_LOCAL_LIVE_STATS=1

# --- paid engine clients ------------------------------------------------------
# Signed license for importing a paid engine client directly from a clone.
# Issue one with: node scripts/mint-license.mjs --out /path/to/license.txt
# VERIFY402_LICENSE_KEY=
# Offline test harness only: lets the proxy run without a license.
# Refused when X402_MODE=mainnet. Never set on a public instance.
# VERIFY402_LICENSE_BYPASS=1

# --- private paid-engine service ----------------------------------------------
# Required for any paid check. The public package contains no engine
# implementation; when these are unset the clients fail closed.
# VERIFY402_ENGINE_URL=
# VERIFY402_ENGINE_TOKEN=
