# Variables below are deliberately commented out: this file is a template, not a live
# environment. Uncomment and fill in the values you need. In mainnet mode the
# server refuses to start unless these are set: PREFLIGHT_SECRET, AGENT_URL,
# FACILITATOR_URL, and (when using Coinbase) CDP_API_KEY_ID + CDP_API_KEY_SECRET.
#
# Copy to .env. Never commit the real file.
#
# Every environment variable read by the server, registration script, test
# harness, or MCP bridge is listed below. Values shown are examples/defaults;
# replace secrets and addresses before running in mainnet.

# --- payment rails -----------------------------------------------------------
# Testnet (default): Base Sepolia + Solana devnet, public facilitator.
# X402_MODE=testnet

# Mainnet needs a production facilitator and REAL wallets. The server refuses
# to start in mainnet mode without FACILITATOR_URL, AGENT_URL, and
# PREFLIGHT_SECRET.
# Mainnet also requires an always-on paid host. On a free host keep X402_MODE=testnet.
# MAINNET_ALWAYS_ON_CONFIRMED=yes
# REQUIRE_ALWAYS_ON=1
# Never set this on a free host:
# ALLOW_MAINNET_ON_FREE_TIER=1
# X402_MODE=mainnet
# FACILITATOR_URL=https://api.cdp.coinbase.com/platform/v2/x402
# CDP_API_KEY_ID=...
# CDP_API_KEY_SECRET=...

# Public identity. REQUIRED when X402_MODE=mainnet: the agent card must not
# derive its origin from the Host header. In testnet/local mode, unset AGENT_URL
# falls back to this Host allowlist (comma-separated hostnames).
# AGENT_URL=https://verify402.onrender.com
# TRUSTED_HOSTS=verify402.onrender.com,localhost,127.0.0.1

# Where payments land.
# PAY_TO_EVM=0x...
# PAY_TO_SVM=...

# Prices per paid call, in USD. The 402 challenge is authoritative.
# PRICE=$0.05              # /verify
# SAFETY_PRICE=$0.10       # /safety (pre-trade gate, does more work)
# ROUTE_PRICE=$0.03        # /route
# QUOTECHECK_PRICE=$0.05   # /quotecheck
# DEPTH_PRICE=$0.05        # /depth

# --- preflight receipts ------------------------------------------------------
# HMAC secret for /preflight receipts. REQUIRED when X402_MODE=mainnet: without
# it the process would mint receipts that cannot be verified after a restart.
# Generate with: openssl rand -hex 32
# PREFLIGHT_SECRET=...

# --- readiness and server ----------------------------------------------------
# READY_CHAIN_ID=1              # 1, 42161, 8453, or 84532 (Base Sepolia, readiness-only)
# READY_RPC_URL=https://your-readiness-endpoint
# BASE_SEPOLIA_RPC_URL=https://your-base-sepolia-endpoint  # fallback when READY_CHAIN_ID=84532
# PORT=4021
# SIGTERM/SIGINT drain deadline before forcing close (milliseconds).
# SHUTDOWN_TIMEOUT_MS=10000

# --- ERC-8004 agent identity registration (scripts/register-agent.mjs) --------
# PRIVATE_KEY is the OWNER's gas wallet. Never paste it into chat or a ticket.
# PRIVATE_KEY=...
# CHAIN=base-sepolia            # or: base
# CONFIRM=yes                   # required - the mint is permanent
# AGENT_URL (above) is also required for registration.
# AGENT_ID=...
# IDENTITY_REGISTRY=0x...
# CHAIN_ID=84532                # registry chain for the agent identity

# --- measurement data sources (all optional; public endpoints are the default) ---
# A private endpoint matters under sustained traffic - the public ones throttle.
# ETH_RPC_URL=https://your-mainnet-endpoint
# ARB_RPC_URL=https://your-arbitrum-endpoint
# BASE_RPC_URL=https://your-base-endpoint
# BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# --- local development only --------------------------------------------------
# BYPASS_PAYMENT=1   # unprotects /verify; loud warning is printed

# --- test harness only -------------------------------------------------------
# TEST_OFFLINE=1
# TEST_RPC_ONLY=1
# TEST_OFFLINE_RPC_URL=http://127.0.0.1:1/offline-rpc

# --- post-deploy smoke (scripts/smoke.mjs) ------------------------------------
# SMOKE_BASE_URL=https://verify402.onrender.com
# SMOKE_PAID=1               # requires EVM_PRIVATE_KEY and a TESTNET target
# Expected release identity for scripts/post-deploy-check.mjs (default 1.0.8/testnet)
# EXPECTED_VERSION=1.0.8
# EXPECTED_MODE=testnet

# --- MCP bridge (optional; run from mcp-bridge/) -----------------------------
# Dedicated hot wallet for x402 payments only - never a trading key.
# EVM_PRIVATE_KEY=0x...
# VERIFY402_URL=https://verify402.onrender.com
# Public demo payment rail: Base Sepolia testnet. This active value is the
# template for the public demo and matches the bridge's runtime default.
VERIFY402_NETWORKS=eip155:84532
# Future mainnet deployment only: explicit opt-in, mainnet facilitator and host.
# Do not use this against the public demo.
# VERIFY402_NETWORKS=eip155:8453
# VERIFY402_PAY_TO=0x...
# VERIFY402_RESOURCE_PREFIX=https://verify402.onrender.com
# MAX_PAYMENT_USD=0.25
# MAX_DAILY_USD=5.00
